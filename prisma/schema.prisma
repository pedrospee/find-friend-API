generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Org {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  whatsapp     String
  address      String
  city         String
  createdAt    DateTime @default(now()) @map("created_at")

  pets Pet[]

  @@map("orgs")
}

model Pet {
  id          String         @id @default(uuid())
  name        String
  about       String
  city        String
  age         PetAge
  size        PetSize
  energyLevel PetEnergyLevel @map("energy_level")
  orgId       String         @map("org_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  org Org @relation(fields: [orgId], references: [id])

  @@map("pets")
}

enum PetAge {
  FILHOTE
  ADULTO
  IDOSO
}

enum PetSize {
  PEQUENO
  MEDIO
  GRANDE
}

enum PetEnergyLevel {
  BAIXA
  MEDIA
  ALTA
}
